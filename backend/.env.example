# ---- Whisper (speech-to-text) runs locally, no key needed ----
# tiny, base, small, medium (bigger = more accurate, slower)
WHISPER_MODEL=base

# ---- LLM for the clinical summary: pick ONE block below ----

# OPTION A: Groq (free tier, fast)  -> key from console.groq.com
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-key
LLM_MODEL=llama-3.3-70b-versatile

# OPTION B: Google Gemini (free tier) -> key from aistudio.google.com
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-gemini-key
# LLM_MODEL=gemini-2.0-flash

# OPTION C: Ollama (100% local, free, offline) -> install from ollama.com,
#           then run:  ollama pull llama3.1:8b
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.1:8b

# OPTION D: OpenAI
# LLM_PROVIDER=openai
# LLM_BASE_URL=
# LLM_API_KEY=your-openai-key
# LLM_MODEL=gpt-4o-mini

# OPTION E: Anthropic
# LLM_PROVIDER=anthropic
# LLM_API_KEY=your-anthropic-key
# LLM_MODEL=claude-sonnet-4-6
